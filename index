/* ---------- Exercícios ---------- */
const ALL=LESSONS.flatMap(l=>l.p);
function makeQuestions(pool,n){
  let pick=shuffle(pool.slice()).slice(0,Math.min(n,pool.length));
  while(pick.length<n)pick.push(pool[Math.floor(Math.random()*pool.length)]);
  const types=shuffle(Array.from({length:n},(_,i)=>['en2pt','pt2en','listen'][i%3]));
  return pick.map((p,i)=>{const type=types[i],k=type==='pt2en'?0:1,answer=p[k];
    const cands=shuffle(pool.filter(x=>x[k]!==answer)).concat(shuffle(ALL.filter(x=>x[k]!==answer)));
    const opts=[];for(const c of cands){if(!opts.includes(c[k]))opts.push(c[k]);if(opts.length===3)break}
    return{type,p,answer,options:shuffle([answer,...opts])}});
}
let Q=null;
function openQuiz(cfg){Q=Object.assign({i:0,correct:0,res:[],answered:false},cfg);drawQ();}
function closeQuiz(){Q=null;document.getElementById('modal').innerHTML='';if('speechSynthesis' in window)speechSynthesis.cancel()}
function drawQ(){
  const m=document.getElementById('modal');
  const prog=Q.questions.map((_,k)=>`<i class="${k<Q.res.length?(Q.res[k]?'ok':'no'):k===Q.i?'cur':''}"></i>`).join('');
  if(Q.i>=Q.questions.length){
    const pct=Math.round(Q.correct/Q.questions.length*100);
    const msg=pct>=90?'Excelente! Você está pronta para essas situações. 🌟':pct>=70?'Muito bem! Você já se vira nessas situações. 💪':pct>=50?'Bom caminho! Revise as frases e tente de novo: a segunda vez sempre rende mais.':'Todo começo é assim. Ouça as frases mais uma vez e refaça. Você vai ver a diferença.';
    m.innerHTML=`<div class="modal" role="dialog" aria-modal="true" aria-label="Resultado"><div class="sheet"><div class="qtop"><div class="prog">${prog}</div><button class="close" data-act="qclose" aria-label="Fechar">×</button></div>
      <p class="qtype">${esc(Q.title)}</p><div class="big ${pct>=70?'good':'bad'}">${pct}%</div><p>${Q.correct} de ${Q.questions.length} certas. +${Q.gain} XP</p>
      <p class="quote" style="margin:14px 0">${esc(msg)}</p>
      <div class="row"><button class="btn" data-act="qclose">Concluir</button><button class="btn ghost" data-act="qretry">Fazer de novo</button></div></div></div>`;
    return;
  }
  const q=Q.questions[Q.i];
  const prompt=q.type==='en2pt'?['O que significa?',q.p[0]]:q.type==='pt2en'?['Como se diz em inglês?',q.p[1]]:['Ouça e escolha o significado',''];
  m.innerHTML=`<div class="modal" role="dialog" aria-modal="true" aria-label="${esc(Q.title)}"><div class="sheet">
    <div class="qtop"><div class="prog">${prog}</div><button class="close" data-act="qclose" aria-label="Fechar">×</button></div>
    <p class="qtype">${esc(Q.title)}: pergunta ${Q.i+1} de ${Q.questions.length}</p>
    <p class="qtype"><b>${prompt[0]}</b></p>
    ${q.type==='listen'?`<div class="row" style="margin:8px 0 12px"><button class="btn" data-act="say" data-t="${esc(q.p[0])}">🔊 Ouvir</button><button class="btn ghost" data-act="say" data-slow="1" data-t="${esc(q.p[0])}">🐢 Devagar</button></div>`:`<p class="qtext">${esc(prompt[1])}</p>`}
    ${q.options.map((o,k)=>`<button class="opt" data-act="ans" data-k="${k}">${esc(o)}</button>`).join('')}
    <div class="fb" id="fb" aria-live="polite"></div>
    <button class="btn hidden" id="next" data-act="qnext">${Q.i+1<Q.questions.length?'Próxima':'Ver resultado'}</button>
  </div></div>`;
  if(q.type==='listen')setTimeout(()=>say(q.p[0]),250);
}
function answer(k){
  if(Q.answered)return;Q.answered=true;const q=Q.questions[Q.i],ok=q.options[k]===q.answer;
  document.querySelectorAll('.opt').forEach((b,j)=>{b.disabled=true;if(q.options[j]===q.answer)b.classList.add('right');else if(j===+k)b.classList.add('wrong')});
  if(ok)Q.correct++;Q.res.push(ok);
  document.getElementById('fb').innerHTML=ok?`<span class="good">Correct! ${esc(q.p[0])}</span>`:`<span class="bad">Quase! “${esc(q.p[0])}” significa “${esc(q.p[1])}”.</span>`;
  say(q.p[0]);const n=document.getElementById('next');n.classList.remove('hidden');n.focus();
}
function nextQ(){Q.i++;Q.answered=false;if(Q.i>=Q.questions.length)finishQuiz();drawQ()}
function finishQuiz(){
  const pct=Math.round(Q.correct/Q.questions.length*100);let gain=0;
  if(Q.kind==='lesson'||Q.kind==='review'){const D=day(Q.date);gain=D.main?2*Q.correct:10+5*Q.correct;D.main=true;D.score=Math.max(D.score||0,pct)}
  else{const prev=best(Q.id);gain=prev==null?20+5*Q.correct:3*Q.correct;
    S.tests.push({id:Q.id,date:todayISO(),correct:Q.correct,total:Q.questions.length,pct});
    const it=SCH.find(x=>x.type==='test'&&x.test===Q.id);if(it){const D=day(it.date);D.main=true;D.score=Math.max(D.score||0,pct)}}
  S.xp+=gain;Q.gain=gain;
  [Q.date,(SCH.find(x=>x.test===Q.id)||{}).date].filter(Boolean).forEach(checkBonus);
  save();render();
}
function checkBonus(s){const D=S.days[s];if(D&&isDone(s)&&!D.bonus){D.bonus=true;S.xp+=20;window._pop=s;
  const idx=SCH.findIndex(x=>x.date===s);setTimeout(()=>toast('Dia completo! +20 XP de bônus 🎉'),300)}}
function startQuiz(b){
  const kind=b.dataset.kind,d=b.dataset.d||todayISO();
  if(kind==='lesson'){const l=LESSONS[+b.dataset.li];openQuiz({kind,date:d,title:`Aula ${+b.dataset.li+1}: ${l.t}`,questions:makeQuestions(l.p,6),src:b});return}
  if(kind==='review'){const pool=covered().flatMap(l=>l.p);openQuiz({kind,date:d,title:'Revisão geral',questions:makeQuestions(pool.length?pool:ALL,12),src:b});return}
  const id=b.dataset.id;let pool,n;
  if(id==='diag'){pool=ALL;n=15}else if(id==='final'){pool=ALL;n=20}
  else if(id==='practice'){const c=covered();pool=(c.length?c:LESSONS.slice(0,1)).flatMap(l=>l.p);n=10}
  else{const w=+id.slice(1);const wk=LESSONS.filter(l=>l.w===w).flatMap(l=>l.p);const prevW=LESSONS.filter(l=>l.w<w).flatMap(l=>l.p);
    pool=null;const qs=makeQuestions(wk,prevW.length?9:12).concat(prevW.length?makeQuestions(prevW,3):[]);
    openQuiz({kind:'test',id,date:d,title:testName(id),questions:shuffle(qs),src:b});return}
  openQuiz({kind:'test',id,date:d,title:testName(id),questions:makeQuestions(pool,n),src:b});
}

/* ---------- Nuvem (Firebase) ---------- */
let fb=null,user=null,pushT=null,cloudErr='';
async function initCloud(){
  if(!FIREBASE_CONFIG)return;
  try{
    const V='10.12.2',base=`https://www.gstatic.com/firebasejs/${V}/`;
    const [A,Au,F]=await Promise.all([import(base+'firebase-app.js'),import(base+'firebase-auth.js'),import(base+'firebase-firestore.js')]);
    const app=A.initializeApp(FIREBASE_CONFIG),auth=Au.getAuth(app),db=F.getFirestore(app);
    fb={auth,db,F,Au,provider:new Au.GoogleAuthProvider()};
    Au.onAuthStateChanged(auth,async u=>{user=u;
      if(u){try{const snap=await F.getDoc(F.doc(db,'progress',u.uid));
        if(snap.exists()&&(snap.data().updatedAt||0)>(S.updatedAt||0)){S=Object.assign(blank(),snap.data());try{localStorage.setItem(KEY,JSON.stringify(S))}catch(e){}SCH=buildSchedule();toast('Progresso carregado da nuvem.')}
        else cloudPush(true)}catch(e){cloudErr='Não foi possível ler a nuvem. Confira as regras do Firestore.'}}
      render()});
  }catch(e){cloudErr='Não consegui carregar o Firebase. Confira a configuração no topo do código.';render()}
}
function cloudPush(now){if(!fb||!user)return;clearTimeout(pushT);
  pushT=setTimeout(()=>fb.F.setDoc(fb.F.doc(fb.db,'progress',user.uid),JSON.parse(JSON.stringify(S))).catch(()=>toast('Não salvou na nuvem agora. O progresso continua salvo neste aparelho.')),now?0:800)}
function cloudPanel(){
  if(!FIREBASE_CONFIG)return '<p class="muted small">O progresso está salvo neste aparelho. Para usar no celular e no computador ao mesmo tempo, preencha FIREBASE_CONFIG no código (veja o LEIA-ME).</p>';
  if(cloudErr)return `<p class="bad small">${esc(cloudErr)}</p>`;
  if(!fb)return '<p class="muted small">Conectando ao Firebase…</p>';
  return user?`<p class="small">Sincronizado com <b>${esc(user.email||'sua conta Google')}</b>.</p><button class="btn ghost sm" data-act="logout">Sair</button>`
    :'<p class="muted small">Entre com o Google para salvar o progresso na nuvem e continuar em qualquer aparelho.</p><button class="btn" data-act="login">Entrar com Google</button>';
}

/* ---------- Eventos ---------- */
document.addEventListener('click',e=>{
  const b=e.target.closest('[data-act]');if(!b)return;const a=b.dataset.act;
  if(a==='view'){view=b.dataset.v;if(view==='hoje')selDate=null;render();scrollTo(0,0)}
  else if(a==='open'){selDate=b.dataset.d;view='hoje';render();scrollTo(0,0)}
  else if(a==='say')say(b.dataset.t,!!b.dataset.slow);
  else if(a==='toggle'){const D=day(b.dataset.d),k=b.dataset.k;D[k]=!D[k];S.xp=Math.max(0,S.xp+(D[k]?10:-10));
    if(D[k])toast(k==='duo'?'Duolingo feito! +10 XP 🦉':'Podcast ouvido! +10 XP 🎧',2200);checkBonus(b.dataset.d);save();render()}
  else if(a==='quiz')startQuiz(b);
  else if(a==='ans')answer(b.dataset.k);
  else if(a==='qnext')nextQ();
  else if(a==='qclose')closeQuiz();
  else if(a==='qretry'){const src=Q.src;closeQuiz();startQuiz(src)}
  else if(a==='export'){const blob=new Blob([JSON.stringify(S,null,2)],{type:'application/json'});const u=URL.createObjectURL(blob);const l=document.createElement('a');l.href=u;l.download=`ingles-viagem-backup-${todayISO()}.json`;document.body.appendChild(l);l.click();l.remove();URL.revokeObjectURL(u)}
  else if(a==='reset'){if(confirm('Zerar todo o progresso? Esta ação não pode ser desfeita.')){const cfg=S.cfg;S=blank();S.cfg=cfg;SCH=buildSchedule();save();render();toast('Progresso zerado. Um novo começo!')}}
  else if(a==='login'&&fb)fb.Au.signInWithPopup(fb.auth,fb.provider).catch(()=>toast('Login não concluído. Confira se o domínio está autorizado no Firebase Authentication.'));
  else if(a==='logout'&&fb)fb.Au.signOut(fb.auth);
});
document.addEventListener('change',e=>{
  const el=e.target;
  if(el.dataset.actFile==='import'&&el.files[0]){const r=new FileReader();r.onload=()=>{try{const d=JSON.parse(r.result);if(!d.days||!d.cfg)throw 0;S=Object.assign(blank(),d);SCH=buildSchedule();save();render();toast('Backup restaurado.')}catch(x){toast('Arquivo inválido. Use um backup baixado por este app.')}};r.readAsText(el.files[0]);return}
  const f=el.dataset.field;if(!f)return;
  if(f.startsWith('cfg.')){const k=f.slice(4);if(k==='trip'&&!/^\d{4}-\d{2}-\d{2}$/.test(el.value))return;S.cfg[k]=el.value.trim();if(k==='trip')SCH=buildSchedule();save();render();return}
  const D=day(el.dataset.d);D[f]=f==='duoXp'?(el.value===''?'':Math.max(0,+el.value||0)):el.value;save();
});
document.addEventListener('input',e=>{if(e.target.id!=='q')return;const q=e.target.value.trim().toLowerCase();
  document.querySelectorAll('.phrase').forEach(p=>p.classList.toggle('hidden',!!q&&!p.dataset.s.includes(q)));
  document.querySelectorAll('.group').forEach(g=>g.classList.toggle('hidden',!g.querySelector('.phrase:not(.hidden)')));
});
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&Q)closeQuiz()});

SCH=buildSchedule();
render();
initCloud();
</script>
