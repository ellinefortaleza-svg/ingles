  const pods=Object.values(S.days).filter(d=>d.pod).length;
  const duoXp=Object.values(S.days).reduce((a,d)=>a+(+d.duoXp||0),0);
  const lv=level();
  const diag=S.tests.find(x=>x.id==='diag');const lastReal=S.tests.filter(x=>x.id!=='diag'&&x.id!=='practice').slice(-1)[0];
  let evo='';
  if(diag&&lastReal){const d=lastReal.pct-diag.pct;evo=d>0?`No nivelamento você acertou ${diag.pct}%. No último teste, ${lastReal.pct}%. São ${d} pontos a mais. Isso é evolução de verdade! 🎉`:`No nivelamento você acertou ${diag.pct}% e no último teste ${lastReal.pct}%. Revise as frases da semana e refaça o teste: a repetição é o que fixa.`}
  else if(diag)evo=`Seu ponto de partida: ${diag.pct}% no nivelamento. O próximo teste já vai mostrar o quanto você avançou.`;
  return `<div class="head"><div><h2>Sua evolução</h2><p class="muted">${esc(fill('Cada número aqui é um passo rumo a {dest}.'))}</p></div></div>
  <div class="stats">
    <div class="stat"><b>🔥 ${streak()}</b><span>dias seguidos estudando</span></div>
    <div class="stat"><b>${done}/${sd.length}</b><span>dias carimbados</span></div>
    <div class="stat"><b>${lessonsDone}/${LESSONS.length}</b><span>aulas concluídas</span></div>
    <div class="stat"><b>${pods}</b><span>podcasts ouvidos</span></div>
    <div class="stat"><b>${duoXp}</b><span>XP no Duolingo</span></div>
    <div class="stat lvl"><b>${S.xp} XP</b><span>${esc(lv.name)}${lv.next?`. Faltam ${lv.need} XP para ${esc(lv.next)}`:''}</span><div class="bar"><i style="width:${lv.pct}%"></i></div></div>
  </div>
  <div class="panel"><h3>Resultados dos testes</h3>${evo?`<p>${esc(evo)}</p>`:''}${chart()}</div>
  <div class="panel settings"><h3>Configurações</h3>
    <label for="cf-name">Seu nome</label><input id="cf-name" data-field="cfg.name" value="${esc(S.cfg.name)}">
    <label for="cf-dest">Destino</label><input id="cf-dest" data-field="cfg.dest" value="${esc(S.cfg.dest)}">
    <label for="cf-trip">Data do embarque</label><input id="cf-trip" type="date" data-field="cfg.trip" min="2026-10-12" value="${esc(S.cfg.trip)}">
    <div class="row" style="margin-top:14px"><button class="btn ghost sm" data-act="export">Baixar backup</button>
    <label class="btn ghost sm" style="display:inline-block">Restaurar backup<input type="file" accept="application/json" data-act-file="import" class="hidden"></label>
    <button class="btn ghost sm" data-act="reset">Zerar progresso</button></div>
  </div>
  <div class="panel"><h3>Sincronizar entre aparelhos</h3>${cloudPanel()}</div>`;
}

function vPhrases(){
  return `<div class="head"><div><h2>Minhas frases</h2><p class="muted">${LESSONS.length*5} frases organizadas por situação, com áudio. Use durante a viagem.</p></div></div>
  <input class="search" type="search" id="q" placeholder="Buscar em inglês ou português (ex.: conta, taxi)" aria-label="Buscar frase">
  ${WEEKS.map((w,wi)=>`<div class="panel"><h3>${w.e} ${esc(w.t)}</h3>${LESSONS.filter(l=>l.w===wi).map(l=>`<div class="group"><p class="small muted" style="margin:10px 0 0"><b>${esc(l.t)}</b></p>${l.p.map(phraseRow).join('')}</div>`).join('')}</div>`).join('')}`;
}

function render(){
  renderPass();
  document.querySelectorAll('nav.tabs button').forEach(b=>b.setAttribute('aria-current',String(b.dataset.v===view)));
  document.getElementById('main').innerHTML=({hoje:vToday,plano:vPlan,testes:vTests,evolucao:vProgress,frases:vPhrases})[view]();
  window._pop=null;
