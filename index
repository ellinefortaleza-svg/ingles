/* ---------- Cronograma ---------- */
function buildSchedule(){
  const out=[];let li=0;const tested=new Set();
  const end=S.cfg.trip;const last=iso(new Date(parse(end).getTime()-864e5));
  for(let d=parse(START);iso(d)<=end;d.setDate(d.getDate()+1)){
    const s=iso(d),dow=d.getDay();let it;
    if(s===end) it={type:'trip'};
    else if(s===last) it={type:'test',test:'final'};
    else if(dow===0&&li>0&&!tested.has(LESSONS[li-1].w)){const w=LESSONS[li-1].w;tested.add(w);it={type:'test',test:'w'+w,week:w}}
    else if(li<LESSONS.length) it={type:'lesson',li:li++};
    else it={type:'review'};
    it.date=s;out.push(it);
  }
  return out;
}
const studyDays=()=>SCH.filter(x=>x.type!=='trip');
const clampDate=s=>{if(!SCH.length)return s;if(s<SCH[0].date)return SCH[0].date;const l=SCH[SCH.length-1].date;return s>l?l:s};
function isDone(s){const it=SCH.find(x=>x.date===s);if(!it||it.type==='trip')return false;const D=S.days[s];return !!(D&&D.duo&&D.pod&&D.main)}
function covered(){const t=todayISO();return SCH.filter(x=>x.type==='lesson'&&(x.date<=t||(S.days[x.date]&&S.days[x.date].main))).map(x=>LESSONS[x.li])}
function testName(id){if(id==='diag')return 'Teste de nivelamento';if(id==='final')return 'Teste final';if(id==='practice')return 'Treino livre';if(id==='review')return 'Revisão geral';const w=+id.slice(1);return `Teste da semana ${w+1}: ${WEEKS[w].t}`}
function itemLabel(it){if(it.type==='lesson')return `Aula ${it.li+1}`;if(it.type==='review')return 'Revisão';if(it.type==='trip')return 'Embarque';return it.test==='final'?'Teste final':'Teste'}

