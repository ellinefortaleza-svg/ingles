function streak(){let n=0;let d=parse(todayISO());const st=s=>{const D=S.days[s];return (D&&(D.duo||D.pod||D.main))||S.tests.some(t=>t.date===s)};
  if(!st(iso(d)))d.setDate(d.getDate()-1);
  while(st(iso(d))){n++;d.setDate(d.getDate()-1)}return n}
function level(){let i=0;LEVELS.forEach((l,k)=>{if(S.xp>=l.x)i=k});const cur=LEVELS[i],nx=LEVELS[i+1];
  return{name:cur.n,next:nx?nx.n:null,pct:nx?Math.round((S.xp-cur.x)/(nx.x-cur.x)*100):100,need:nx?nx.x-S.xp:0}}
const fill=t=>t.replace(/\{dest\}/g,S.cfg.dest||'sua viagem').replace(/\{name\}/g,S.cfg.name||'você');
function quoteFor(s){const i=Math.abs(diff(START,s))%QUOTES.length;return fill(QUOTES[i])}
const best=id=>{const r=S.tests.filter(t=>t.id===id);return r.length?Math.max(...r.map(t=>t.pct)):null};

