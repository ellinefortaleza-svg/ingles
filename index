function chart(){
  const t=S.tests.filter(x=>x.id!=='practice'&&x.id!=='review');
  if(!t.length)return '<p class="muted">Faça o teste de nivelamento para começar o gráfico.</p>';
  const W=600,H=230,pl=40,pr=18,pt=16,pb=38,n=t.length;
  const x=i=>pl+(n===1?(W-pl-pr)/2:i*(W-pl-pr)/(n-1)),y=v=>pt+(100-v)*(H-pt-pb)/100;
  const lab=id=>id==='diag'?'Nível':id==='final'?'Final':'S'+(+id.slice(1)+1);
  let g='';[0,50,70,100].forEach(v=>{g+=`<line x1="${pl}" x2="${W-pr}" y1="${y(v)}" y2="${y(v)}" stroke="var(--line)" ${v===70?'stroke-dasharray="5 5"':''}/><text x="${pl-8}" y="${y(v)+4}" text-anchor="end" font-size="12" fill="var(--muted)">${v}%</text>`});
  const pts=t.map((r,i)=>`${x(i)},${y(r.pct)}`).join(' ');
  const dots=t.map((r,i)=>`<circle cx="${x(i)}" cy="${y(r.pct)}" r="6" fill="${r.pct>=70?'var(--stamp)':'var(--maple)'}"/>${n<=14?`<text x="${x(i)}" y="${H-12}" text-anchor="middle" font-size="12" fill="var(--muted)">${lab(r.id)}</text>`:''}`).join('');
  return `<svg viewBox="0 0 ${W} ${H}" width="100%" role="img" aria-label="Gráfico dos resultados dos testes">${g}<polyline points="${pts}" fill="none" stroke="var(--maple)" stroke-width="3" stroke-linejoin="round"/>${dots}</svg>
  <p class="small muted">A linha tracejada marca 70%, o nível em que você já se vira bem nas situações da viagem.</p>`;
}

